# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# "sqlite" (default, zero setup - good for a free/demo deployment) or "mysql"
DB_ENGINE=sqlite
SQLITE_PATH=cctv.db

# Only used when DB_ENGINE=mysql
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cctv_db

# --- Redis (Celery broker + result backend + live-frame store) ---
# Host/port/db. Docker Compose overrides host to `redis` for api/worker.
REDIS_URL=redis://localhost:6379/0
# Required. Compose will refuse to start Redis without this.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# --- Flask server ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
# Public base URL the API is reachable at (used to build camera snapshot URLs)
API_BASE_URL=http://localhost:5000
# "*" for local dev, or a comma-separated list of allowed frontend origins in production
CORS_ALLOWED_ORIGINS=*
# Max accepted request body size in bytes (default 1 MiB)
MAX_CONTENT_LENGTH_BYTES=1048576

# --- Authentication (optional Phase-1 gate) ---
# Shared API key. Leave empty for an open local demo. When set, every API /
# stream / camera-view request must present the same value via X-API-Key,
# Authorization: Bearer <key>, or ?api_key=<key> (for <img>/MJPEG).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# JWT secret for multi-user auth. Required for login/register/org features.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# Access token lifetime in hours
JWT_TTL_HOURS=12
# Login/register attempts per IP+email within the window
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
# Set true only when the app sits behind a trusted reverse proxy
TRUST_X_FORWARDED_FOR=false

# --- Invite emails (optional) ---
# Leave unset to skip sending invites by email.
# Recommended free SMTP options: Gmail app password, Brevo (sendinblue), Mailgun.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=CCTV Console
MAIL_USE_TLS=true

# Flask CLI entrypoint (used by `flask db ...` migration commands)
FLASK_APP=app.py
# true (default): auto-create tables on startup for the SQLite demo.
# Set false when running `flask db migrate` / `flask db upgrade`.
AUTO_CREATE_TABLES=true

# --- Stream URL security (SSRF mitigation) ---
# Comma-separated allow-list of accepted camera URL schemes
ALLOWED_STREAM_SCHEMES=rtsp,rtsps
# Set to true in any real/public deployment to reject private/loopback/link-local
# camera targets. Kept false by default so the local rtsp://localhost demo works.
BLOCK_PRIVATE_STREAM_TARGETS=false
# Max time (ms) FFmpeg waits when opening/reading a stream (bounds add-camera)
STREAM_TIMEOUT_MS=10000

# --- Detection services ---
# true (default): no desktop windows/audio; frames are published to Redis for
# the /api/camera/<id>/stream live view instead. Set to false only if running
# on your own machine with a display and you want debug preview windows.
HEADLESS=true

# Where camera snapshots and saved alert clips are written
CAMERA_SNAPSHOT_DIR=cctv_snip
SAVED_CLIPS_DIR=saved_clips

# Model weights. yolov8n.pt auto-downloads from Ultralytics if not present
# locally, which keeps the free/demo deployment CPU-friendly. The shoplifting
# model is a custom-trained weight and must be provided (no auto-download).
CROWD_MODEL_PATH=src/trained-models/yolov8n.pt
RESTRICTED_MODEL_PATH=src/trained-models/yolov8n.pt
SHOPLIFTING_MODEL_PATH=src/trained-models/shoplifting_best.pt

# Run YOLO inference every Nth frame (higher = lighter on CPU, less responsive)
DETECTION_FRAME_SKIP=3
SHOPLIFTING_FRAME_SKIP=2
# Minimum time between restricted-zone alerts for the same running rule.
RESTRICTED_ALERT_COOLDOWN_SECONDS=60
